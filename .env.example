# Copy to .env and edit. All values are optional in development.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TAX_RATE=0.10

# Database: sqlite (default) or mysql
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=storefront
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
